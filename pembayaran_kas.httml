<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#260B1D">
  <title>Pembayaran Kas KUMAWA Cilacap</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Georgia, serif;
    }

    body {
      min-height: 100vh;
      padding: 25px 14px;
      color: #F7EAF0;
      background:
        radial-gradient(ellipse at top left, #70405B 0%, transparent 45%),
        radial-gradient(ellipse at bottom right, #70405B 0%, transparent 40%),
        linear-gradient(135deg, #260B1D, #54233F, #170811);
    }

    .container {
      max-width: 600px;
      margin: auto;
    }

    .header {
      text-align: center;
      padding: 35px 15px;
      margin-bottom: 20px;
      border: 1px solid #E8CBA0;
      border-radius: 22px;
      background: linear-gradient(135deg, #54233F, #260B1D);
      box-shadow: 0 0 25px #B9829C30;
    }

    h1 {
      font-size: clamp(21px, 5vw, 29px);
      margin-bottom: 12px;
      line-height: 1.3;
    }

    .subtitle {
      color: #E8CBA0;
      letter-spacing: 4px;
      font-size: 13px;
    }

    .info {
      padding: 17px;
      margin-bottom: 20px;
      border: 1px solid #8C5473;
      border-left: 5px solid #B9829C;
      border-radius: 12px;
      background: #310D24;
      line-height: 1.7;
      font-size: 14px;
    }

    .form-box {
      padding: 25px 20px;
      border: 1px solid #B9829C;
      border-radius: 18px;
      background: linear-gradient(145deg, #54233F, #260B1D);
      box-shadow: 0 10px 30px #00000040;
    }

    .form-group {
      margin-bottom: 23px;
    }

    label {
      display: block;
      margin-bottom: 10px;
      font-size: 17px;
      font-weight: bold;
    }

    .required {
      color: #E8CBA0;
    }

    input[type="text"],
    input[type="number"],
    input[type="file"] {
      width: 100%;
      min-width: 0;
      padding: 14px;
      border: 1px solid #B9829C;
      border-radius: 10px;
      background: #260B1D;
      color: #F7EAF0;
      font-size: 15px;
    }

    input::placeholder {
      color: #D6B8C9;
    }

    input:focus {
      outline: 2px solid #E8CBA0;
      border-color: #E8CBA0;
    }

    .petunjuk {
      margin-top: 8px;
      color: #D6B8C9;
      font-size: 12px;
      line-height: 1.6;
    }

    .preview {
      display: none;
      width: 100%;
      max-height: 300px;
      object-fit: contain;
      margin-top: 14px;
      padding: 8px;
      border: 1px dashed #E8CBA0;
      border-radius: 10px;
      background: #260B1D;
    }

    button {
      width: 100%;
      padding: 16px 10px;
      border: 1px solid #E8CBA0;
      border-radius: 12px;
      background: linear-gradient(135deg, #B9829C, #54233F, #8C5473);
      color: white;
      font-size: 17px;
      font-weight: bold;
      cursor: pointer;
      box-shadow: 0 5px 18px #B9829C30;
    }

    button:disabled {
      opacity: 0.6;
      cursor: wait;
    }

    .status {
      display: none;
      margin-top: 16px;
      padding: 13px;
      border-radius: 9px;
      line-height: 1.6;
      overflow-wrap: anywhere;
      font-size: 14px;
    }

    .footer {
      padding: 25px 10px 10px;
      text-align: center;
      color: #E8CBA0;
      font-size: 13px;
      line-height: 2;
      letter-spacing: 2px;
    }

    .footer p {
      letter-spacing: 1px;
      color: #D6B8C9;
    }

    @media (max-width: 400px) {
      .form-box {
        padding: 20px 14px;
      }

      .subtitle {
        letter-spacing: 2px;
      }

      label {
        font-size: 16px;
      }
    }
  </style>
</head>

<body>
  <main class="container">

    <header class="header">
      <h1>PEMBAYARAN UANG KAS</h1>
      <p class="subtitle">KUMAWA CILACAP</p>
    </header>

    <section class="info">
      Selamat datang di formulir pembayaran uang kas
      KUMAWA Cilacap.
      <br>
      Silakan isi nama lengkap, nominal pembayaran,
      dan unggah bukti transfer dengan jelas.
    </section>

    <section class="form-box">
      <form id="formPembayaran">

        <div class="form-group">
          <label for="nama">
            Nama Lengkap <span class="required">*</span>
          </label>
          <input
            type="text"
            id="nama"
            name="nama"
            placeholder="Masukkan nama lengkap"
            maxlength="150"
            autocomplete="name"
            required
          >
        </div>

        <div class="form-group">
          <label for="nominal">
            Nominal Pembayaran (Rp)
            <span class="required">*</span>
          </label>
          <input
            type="number"
            id="nominal"
            name="nominal"
            placeholder="Contoh: 100000"
            min="1"
            step="1"
            required
          >
        </div>

        <div class="form-group">
          <label for="bukti">
            Bukti Transfer <span class="required">*</span>
          </label>
          <input
            type="file"
            id="bukti"
            name="bukti"
            accept="image/jpeg,image/png,image/webp"
            required
          >
          <p class="petunjuk">
            Format JPG, PNG, atau WEBP. Maksimal 5 MB.
          </p>
          <img
            id="preview"
            class="preview"
            alt="Pratinjau bukti transfer"
          >
        </div>

        <button type="submit" id="tombolKirim">
          ➤ Kirim Pembayaran
        </button>

        <div
          class="status"
          id="status"
          role="status"
          aria-live="polite"
        ></div>

      </form>
    </section>

    <footer class="footer">
      ♡ KUMAWA CILACAP ♡
      <p>Formulir Pembayaran Uang Kas</p>
    </footer>

  </main>

  <script>
    // GANTI dengan URL Google Apps Script milikmu.
    const URL_APPS_SCRIPT =
      "TEMPEL_URL_APPS_SCRIPT_DI_SINI";

    const form = document.getElementById("formPembayaran");
    const inputBukti = document.getElementById("bukti");
    const preview = document.getElementById("preview");
    const tombol = document.getElementById("tombolKirim");
    const statusBox = document.getElementById("status");

    let fileValid = false;

    function tampilkanStatus(pesan) {
      statusBox.textContent = pesan;
      statusBox.style.display = "block";
    }

    inputBukti.addEventListener("change", function () {
      const file = this.files[0];

      fileValid = false;
      preview.style.display = "none";
      preview.removeAttribute("src");

      if (!file) return;

      const formatDiizinkan = [
        "image/jpeg",
        "image/png",
        "image/webp"
      ];

      if (!formatDiizinkan.includes(file.type)) {
        this.value = "";
        tampilkanStatus("Pilih gambar JPG, PNG, atau WEBP.");
        return;
      }

      if (file.size > 5 * 1024 * 1024) {
        this.value = "";
        tampilkanStatus("Ukuran bukti transfer maksimal 5 MB.");
        return;
      }

      fileValid = true;
      preview.src = URL.createObjectURL(file);
      preview.style.display = "block";
      statusBox.style.display = "none";
    });

    form.addEventListener("submit", async function (event) {
      event.preventDefault();

      const nama = document.getElementById("nama").value.trim();
      const nominal = Number(
        document.getElementById("nominal").value
      );
      const file = inputBukti.files[0];

      if (!nama || nama.length > 150) {
        tampilkanStatus("Masukkan nama yang valid.");
        return;
      }

      if (!Number.isSafeInteger(nominal) || nominal <= 0) {
        tampilkanStatus("Masukkan nominal pembayaran yang valid.");
        return;
      }

      if (!file || !fileValid) {
        tampilkanStatus("Silakan pilih bukti transfer yang valid.");
        return;
      }

      if (
        !URL_APPS_SCRIPT.startsWith("https://script.google.com/") ||
        URL_APPS_SCRIPT.includes("TEMPEL_URL")
      ) {
        tampilkanStatus(
          "Website belum terhubung. Admin perlu memasukkan URL Google Apps Script."
        );
        return;
      }

      tombol.disabled = true;
      tombol.textContent = "Mengirim...";
      tampilkanStatus("Sedang mengirim data pembayaran...");

      try {
        const base64 = await new Promise((resolve, reject) => {
          const reader = new FileReader();

          reader.onload = () => {
            const hasil = String(reader.result);
            resolve(hasil.split(",")[1]);
          };

          reader.onerror = () =>
            reject(new Error("Gagal membaca gambar."));

          reader.readAsDataURL(file);
        });

        const data = {
          nama: nama,
          nominal: nominal,
          bukti: {
            base64: base64,
            mimeType: file.type
          }
        };

        // Mengirim data ke Google Apps Script.
        await fetch(URL_APPS_SCRIPT, {
          method: "POST",
          mode: "no-cors",
          headers: {
            "Content-Type": "text/plain;charset=utf-8"
          },
          body: JSON.stringify(data)
        });

        tampilkanStatus(
          "Permintaan pengiriman telah dilakukan. " +
          "Status penyimpanan belum dapat dipastikan dari browser. " +
          "Admin perlu memeriksa Google Sheets dan Google Drive."
        );

        form.reset();
        preview.style.display = "none";
        preview.removeAttribute("src");
        fileValid = false;

      } catch (error) {
        tampilkanStatus(
          "Pengiriman gagal atau belum dapat dipastikan. " +
          "Periksa koneksi dan konfigurasi website, lalu hubungi admin."
        );
      } finally {
        tombol.disabled = false;
        tombol.textContent = "➤ Kirim Pembayaran";
      }
    });
  </script>
</body>
</html>
